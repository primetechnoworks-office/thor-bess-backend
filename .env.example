APP_NAME="ThOR BESS Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_TIMEZONE=Asia/Kolkata

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# XAMPP MySQL: create the database first (e.g. in phpMyAdmin: thor_bess, utf8mb4_unicode_ci).
# For a zero-setup local run you can use DB_CONNECTION=sqlite instead (database/database.sqlite).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thor_bess
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Lead notification emails. "log" writes them to storage/logs/laravel.log;
# switch to smtp (or resend/ses/postmark) for production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="website@thorenergybox.com"
MAIL_FROM_NAME="ThOR BESS Website"

# ---------- ThOR BESS ----------
# Next.js website origin(s) allowed to call /api (comma-separated)
FRONTEND_URL=http://localhost:3000
# IPs of the Next.js server(s) that forward form posts here (comma-separated). Use 127.0.0.1 when both run on one machine.
TRUSTED_PROXIES=127.0.0.1
# Shared secret with the website's REVALIDATE_SECRET: blog edits then appear on the site immediately.
WEBSITE_REVALIDATE_SECRET=
# Who receives lead notifications (comma-separated). Quote/contact fall back to LEADS_NOTIFY_EMAIL.
LEADS_NOTIFY_EMAIL=sales@thorenergybox.com,sbbcto@thorenergybox.com
QUOTE_NOTIFY_EMAIL=
CONTACT_NOTIFY_EMAIL=
# Public self-registration on /admin/register (keep false in production; admins add users instead)
ADMIN_ALLOW_REGISTRATION=false
# First admin account created by `php artisan db:seed`
ADMIN_SEED_NAME="ThOR Admin"
ADMIN_SEED_EMAIL=admin@thorenergybox.com
ADMIN_SEED_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
